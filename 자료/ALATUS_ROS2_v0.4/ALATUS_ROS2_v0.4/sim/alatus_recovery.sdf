<?xml version="1.0"?><sdf version="1.9"><world name="alatus_recovery">
<physics name="physics" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
<plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
<plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
<gravity>0 0 -9.80665</gravity>
<light type="directional" name="sun"><pose>0 0 100 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.2 -1</direction></light>
<model name="ground"><static>true</static><link name="ground"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry><material><diffuse>0.3 0.5 0.3 1</diffuse></material></visual></link></model>
<!-- EXPERIMENTAL target x=200 z=30 m, diameter 4 m. No recovery-net capture physics. -->
<model name="archery_target"><static>true</static><pose>200 0 30 0 1.57079632679 0</pose><link name="target">
<visual name="ring0"><pose>0 0 0.0 0 0 0</pose><geometry><cylinder><radius>2.0</radius><length>0.002</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
<visual name="ring1"><pose>0 0 -0.003 0 0 0</pose><geometry><cylinder><radius>1.6</radius><length>0.002</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
<visual name="ring2"><pose>0 0 -0.006 0 0 0</pose><geometry><cylinder><radius>1.2</radius><length>0.002</length></cylinder></geometry><material><ambient>0.05 0.3 1 1</ambient><diffuse>0.05 0.3 1 1</diffuse></material></visual>
<visual name="ring3"><pose>0 0 -0.009000000000000001 0 0 0</pose><geometry><cylinder><radius>0.8</radius><length>0.002</length></cylinder></geometry><material><ambient>1 0.05 0.05 1</ambient><diffuse>1 0.05 0.05 1</diffuse></material></visual>
<visual name="ring4"><pose>0 0 -0.012 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>0.002</length></cylinder></geometry><material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual>
</link></model></world></sdf>