<sensor name="alatus_forward_camera" type="camera">
  <!-- Gazebo camera uses +X forward, +Y left, +Z up. Optical output is x-right/y-down/z-forward. -->
  <pose>0.25 0 0.05 0 0 0</pose>
  <always_on>true</always_on><update_rate>20</update_rate><visualize>true</visualize>
  <topic>/alatus/camera/image</topic><gz_frame_id>camera_optical</gz_frame_id>
  <camera><horizontal_fov>1.0471975512</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>2000</far></clip></camera>
</sensor>
