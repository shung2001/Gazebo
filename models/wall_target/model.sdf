<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wall_target">
    <static>true</static>
    <link name="panel">
      <visual name="target_image">
        <geometry>
          <mesh>
            <uri>model://wall_target/meshes/panel.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://wall_target/materials/textures/image_2.png</albedo_map>
              <metalness>0</metalness>
              <roughness>1</roughness>
            </metal>
          </pbr>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
