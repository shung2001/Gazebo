# 2 x 2 metre vertical target surface in local XY; +Z is the visible side.
# UVs select the white target sheet from the original perspective photo.
mtllib panel.mtl
v -1 -1 0
v 1 -1 0
v 1 1 0
v -1 1 0
vt 0.002 0.089
vt 0.998 0.089
vt 0.850 0.919
vt 0.132 0.919
vn 0 0 1
usemtl target
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
