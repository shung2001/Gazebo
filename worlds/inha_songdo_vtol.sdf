<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="inha_songdo_vtol">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.65 0.78 0.9 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.55 0.55</ambient_light>
        <background_color>0.65 0.78 0.9</background_color>
        <camera_pose>-118 -90 1.6 0 0.124355 0</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>10000</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager" />
      <plugin filename="InteractiveViewControl" name="Interactive view control" />
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu" />
      <plugin filename="CameraTracking" name="Camera tracking" />
      <plugin filename="EntityTree" name="Entity tree" />
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">40</property>
          <property key="height" type="double">40</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>
    <light name="sun" type="directional">
      <pose>0 0 1000 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <attenuation>
        <range>10000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.28 0.22 1</ambient>
            <diffuse>0.34 0.42 0.34 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://inha_songdo_scene</uri>
    </include>
    <!-- 2 x 2 m target on the campus facade, facing the VTOL spawn area. -->
    <include>
      <uri>model://wall_target</uri>
      <name>campus_wall_target</name>
      <pose>-65.380811 -5.656304 8 1.570796327 0 -0.658892054</pose>
    </include>
    <include>
      <uri>model://keyboard_vtol</uri>
      <name>keyboard_vtol</name>
      <pose>-110 -90 0.6 0 0 0</pose>
    </include>
  </world>
</sdf>
